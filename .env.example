# ===== Edward - configurazione =====

# Chiave API di Anthropic (https://platform.claude.com) - obbligatoria per l'AI
ANTHROPIC_API_KEY=

# Modello Claude per TUTTO ciò che tocca dati personali: voce, calendario, termostato, ricerche web.
EDWARD_MODEL=claude-haiku-5-5
# Livello di "ragionamento" per le risposte vocali (low = più veloce/economico)
EDWARD_CHAT_EFFORT=low
# Livello per la composizione notturna del giornale
EDWARD_BRIEFING_EFFORT=medium
# Fallback lato server se il modello rifiuta una richiesta (true/false)
EDWARD_FALLBACKS=true

# ---- Giornale notturno con DeepSeek (opzionale, molto economico) ----
# Se è impostata la chiave, il giornale viene scritto da DeepSeek. Riceve SOLO notizie e meteo, mai il calendario.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Ragionamento prima di rispondere: più lento e costoso, per il giornale non serve
DEEPSEEK_THINKING=false
# Forza il fornitore del giornale: deepseek | anthropic (default: deepseek se c'è la chiave)
BRIEFING_PROVIDER=
# Articoli delle sezioni approfondite da leggere per intero ogni notte
BRIEFING_DEEP_READS=8

# ---- Ricerca web ----
# SearXNG locale (vedi deploy/searxng). Gratis.
SEARXNG_URL=http://localhost:8888
# Riserva quando SearXNG non risponde: Gemini con ricerca Google (5000 ricerche/mese incluse).
# Chiave da https://aistudio.google.com - la ricerca Google richiede un progetto con fatturazione attiva.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Massimo numero di ricerche/pagine lette per singola domanda
MAX_SEARCHES_PER_QUESTION=4

# ---- Termostato BTicino Smarther (app Home + Control) ----
# Crea un'app su https://dev.netatmo.com/apps (con lo stesso account di Home + Control)
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
# Modo più semplice: nella tua app su dev.netatmo.com usa il "Token generator" con gli scope
# read_smarther e write_smarther e incolla qui il REFRESH token (serve solo al primo avvio).
NETATMO_REFRESH_TOKEN=
# In alternativa, login dal sito (Impostazioni → Collega il termostato): indirizzo con cui apri Edward.
# Serve solo per il collegamento con login (non con il token generator); deve combaciare con il redirect URI dell'app Netatmo.
PUBLIC_URL=https://edward.local

# Server
# Porta esterna con Docker (docker compose)
EDWARD_PORT=443
# Porta senza Docker
PORT=3000
HOST=0.0.0.0
TZ=Europe/Rome

# HTTPS (necessario per usare il microfono da un altro dispositivo, es. telefono/PC).
# auto = crea da solo un certificato self-signed al primo avvio (default con Docker)
HTTPS=auto
# Nomi/IP con cui raggiungi il Pi, inclusi nel certificato
CERT_HOSTS=edward.local
# Oppure certificati tuoi (hanno la precedenza):
HTTPS_CERT=
HTTPS_KEY=

# Orario del job notturno (sintassi cron). Default: tutti i giorni alle 05:30
NIGHTLY_CRON=30 5 * * *

# ---- Voce lato server (opzionale, consigliato se usi Chromium sul Raspberry) ----
# Speech-to-text con whisper.cpp (https://github.com/ggml-org/whisper.cpp)
WHISPER_CPP_BIN=
WHISPER_MODEL=
# Text-to-speech con Piper (https://github.com/rhasspy/piper)
PIPER_BIN=
PIPER_MODEL=
# ffmpeg serve per convertire l'audio del browser per whisper
FFMPEG_BIN=ffmpeg
